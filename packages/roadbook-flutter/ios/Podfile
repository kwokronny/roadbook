# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  pod 'AMapSearch', '~> 9.7'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
    end
  end

  # Patch all pod and aggregate xcconfig files in Target Support Files
  target_support_dir = "#{installer.sandbox.root}/Target Support Files"

  # Patch individual pod xcconfig files
  Dir.glob("#{target_support_dir}/**/*.xcconfig").each do |xcconfig_path|
    next if xcconfig_path.include?('/Pods-')  # handled separately below
    content = File.read(xcconfig_path)
    changed = false

    # AMapFoundation sets EXCLUDED_ARCHS[sdk=iphonesimulator*]=arm64 via pod_target_xcconfig.
    # iOS 26+ simulators are arm64-only, so change arm64 exclusion to i386 only.
    if content.include?('EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64')
      content = content.gsub('EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64',
                             'EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386')
      changed = true
    end

    # For amap_flutter_map: remove AMap framework search paths from base, add device-only key.
    # $(inherited) in a conditional key inherits from the base key in the same file, so the
    # simulator-override approach doesn't work. Use device-only key instead.
    if xcconfig_path.include?('/amap_flutter_map/')
      if content =~ /^FRAMEWORK_SEARCH_PATHS = (.+)$/ && !content.include?('FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*]')
        all_fsp = $1
        if all_fsp.include?('AMap3DMap') || all_fsp.include?('AMapFoundation')
          base_fsp = all_fsp
            .gsub('"${PODS_ROOT}/AMap3DMap"', '')
            .gsub('"${PODS_ROOT}/AMapFoundation"', '')
            .gsub(/  +/, ' ')
            .strip
          content = content.sub(/^FRAMEWORK_SEARCH_PATHS = .+$/, "FRAMEWORK_SEARCH_PATHS = #{base_fsp}")
          content += "\nFRAMEWORK_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) \"${PODS_ROOT}/AMap3DMap\" \"${PODS_ROOT}/AMapFoundation\"\n"
          changed = true
        end
      end
      # Remove any leftover simulator-specific patches
      content = content.gsub(/\nFRAMEWORK_SEARCH_PATHS\[sdk=iphonesimulator\*\] = .+\n/, "\n")
    end

    File.write(xcconfig_path, content) if changed
  end

  # Patch aggregate xcconfig files (used as base configuration for Runner target)
  installer.aggregate_targets.each do |agg_target|
    ['debug', 'release', 'profile'].each do |config_name|
      xcconfig_path = "#{installer.sandbox.root}/Target Support Files/#{agg_target.name}/#{agg_target.name}.#{config_name}.xcconfig"
      next unless File.exist?(xcconfig_path)
      content = File.read(xcconfig_path)
      changed = false

      # Fix EXCLUDED_ARCHS: AMapFoundation's user_target_xcconfig propagates arm64 exclusion here.
      # Override to only exclude i386 so arm64 simulator builds work on iOS 26+.
      if content.include?('EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64')
        content = content.gsub('EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64',
                               'EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386')
        changed = true
      end

      # Fix AMap framework linker flags for simulator compatibility.
      # IMPORTANT: $(inherited) in a conditional xcconfig key inherits from the BASE key in the
      # same file — so adding OTHER_LDFLAGS[sdk=iphonesimulator*] would still include AMap via
      # $(inherited). Instead: remove AMap from the BASE key, and add a device-only key with AMap.
      if content =~ /^OTHER_LDFLAGS = (.+)$/ && !content.include?('OTHER_LDFLAGS[sdk=iphoneos*]')
        all_ldflags = $1
        # Check if AMap frameworks are present
        if all_ldflags.include?('AMapFoundationKit') || all_ldflags.include?('MAMapKit') || all_ldflags.include?('AMapSearchKit')
          base_ldflags = all_ldflags
            .gsub('-framework "AMapFoundationKit"', '')
            .gsub('-framework "MAMapKit"', '')
            .gsub('-framework "AMapSearchKit"', '')
            .gsub(/  +/, ' ')
            .strip
          content = content.sub(/^OTHER_LDFLAGS = .+$/, "OTHER_LDFLAGS = #{base_ldflags}")
          content += "\nOTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) -framework \"AMapFoundationKit\" -framework \"MAMapKit\" -framework \"AMapSearchKit\"\n"
          changed = true
        end
      end

      # Fix AMap framework search paths for simulator compatibility.
      # Same approach: remove AMap from the base key, add a device-only key.
      if content =~ /^FRAMEWORK_SEARCH_PATHS = (.+)$/ && !content.include?('FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*]')
        all_fsp = $1
        if all_fsp.include?('AMap3DMap') || all_fsp.include?('AMapFoundation') || all_fsp.include?('AMapSearch')
          base_fsp = all_fsp
            .gsub('"${PODS_ROOT}/AMap3DMap"', '')
            .gsub('"${PODS_ROOT}/AMapFoundation"', '')
            .gsub('"${PODS_ROOT}/AMapSearch"', '')
            .gsub(/  +/, ' ')
            .strip
          content = content.sub(/^FRAMEWORK_SEARCH_PATHS = .+$/, "FRAMEWORK_SEARCH_PATHS = #{base_fsp}")
          content += "\nFRAMEWORK_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) \"${PODS_ROOT}/AMap3DMap\" \"${PODS_ROOT}/AMapFoundation\" \"${PODS_ROOT}/AMapSearch\"\n"
          changed = true
        end
      end

      # Remove any leftover simulator-specific patches from previous approaches
      content = content.gsub(/\nOTHER_LDFLAGS\[sdk=iphonesimulator\*\] = .+\n/, "\n")
      content = content.gsub(/\nFRAMEWORK_SEARCH_PATHS\[sdk=iphonesimulator\*\] = .+\n/, "\n")

      File.write(xcconfig_path, content) if changed
    end
  end
end
